{
  "name": "selfheal",
  "version": "0.2.0",
  "description": "A self-healing CLI wrapper: run a command, and on failure ask an LLM to diagnose and patch the code, then retry. Also exposes 'diagnose' and 'apply' subcommands so any coding agent can call it as a tool.",
  "type": "module",
  "bin": {
    "selfheal": "bin/selfheal.mjs"
  },
  "files": [
    "bin",
    "src",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/selfheal.mjs",
    "test": "node --test test/"
  },
  "keywords": [
    "cli",
    "agent",
    "self-healing",
    "llm",
    "anthropic",
    "openai",
    "auto-fix",
    "diagnose",
    "patch",
    "ci",
    "coding-agent",
    "tool-use"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/selfheal"
  }
}
